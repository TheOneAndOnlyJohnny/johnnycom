# Static site (index.html, es/index.html, content/*.yaml, images). No PHP, no CMS.

Options -Indexes
ServerSignature Off
DirectoryIndex index.html
AddDefaultCharset UTF-8

# Page content (content/en.yaml, content/es.yaml), fetched at runtime
AddType text/yaml .yaml .yml
AddCharset UTF-8 .yaml .yml

# Share images and icons (og-*.png, favicon.ico/.svg, apple-touch-icon.png),
# project images (img/projects/*.webp + .jpg fallback)
AddType image/svg+xml .svg
AddType image/x-icon .ico
AddType image/webp .webp

<IfModule mod_rewrite.c>
	RewriteEngine On

	# The blog lives on its own subdomain: johnny.com.mx/blog/* → blog.johnny.com.mx/*
	# (path and query kept). Its files sit in this folder's blog/, which this
	# .htaccess also covers, so only redirect on the main host, or the subdomain loops.
	RewriteCond %{HTTP_HOST} ^(www\.)?johnny\.com\.mx$ [NC]
	RewriteRule ^blog(?:/(.*))?$ https://blog.johnny.com.mx/$1 [R=301,L]

	# Force HTTPS (keep ACME challenges reachable for certificate renewal)
	RewriteCond %{HTTPS} !=on
	RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

	# Static content only needs GET/HEAD
	RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
	RewriteRule ^ - [R=405,L]

	# Hidden files/dirs (.git, .env, .DS_Store, ...) except .well-known
	RewriteRule (^|/)\.(?!well-known/) - [F,L]

	# Backups, dumps, logs, archives, notes
	RewriteRule \.(bak|old|orig|save|swp|tmp|sql|log|ini|conf|env|sh|md|zip|tar|gz|tgz|7z|rar)$ - [F,NC,L]
</IfModule>

# Never execute PHP or other scripts in this web root
<FilesMatch "\.(php\d*|pht|phtml|phps|phar|cgi|pl|py)$">
	Require all denied
</FilesMatch>

<IfModule mod_headers.c>
	# Browsers ignore HSTS sent over HTTP, so it is safe to send unconditionally.
	# includeSubDomains + preload: every *.johnny.com.mx must serve valid HTTPS.
	Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "DENY"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()"
	Header always set Cross-Origin-Opener-Policy "same-origin"
	Header always set Cross-Origin-Resource-Policy "same-origin"
	Header always set X-Permitted-Cross-Domain-Policies "none"
	Header always unset X-Powered-By
	Header unset X-Powered-By

	# CSP for the pages (SVGs get their own, stricter one below).
	# The self-unpacking bundle needs inline scripts, blob: scripts and eval
	# (dc-runtime evaluates the page logic with new Function).
	<FilesMatch "\.html?$">
		Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline'; font-src https://cdn.jsdelivr.net data:; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
		Header always set Cache-Control "no-cache"
	</FilesMatch>

	# Content edits show up on the next load (revalidated via ETag/Last-Modified).
	# Google must fetch these to render the page, so they can't be blocked in
	# robots.txt; noindex keeps the raw files out of search results instead.
	<FilesMatch "\.ya?ml$">
		Header always set Cache-Control "no-cache"
		Header always set X-Robots-Tag "noindex"
	</FilesMatch>

	# Images and icons: cache for a week, and let other sites' link previews
	# (chat apps that load og:image straight from here) use them.
	<FilesMatch "\.(png|ico|svg|jpe?g|webp)$">
		Header always set Cache-Control "public, max-age=604800"
		Header always set Cross-Origin-Resource-Policy "cross-origin"
	</FilesMatch>
	# An SVG opened directly is a document: never let it run scripts
	<FilesMatch "\.svg$">
		Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'"
	</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/yaml image/svg+xml image/x-icon
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
